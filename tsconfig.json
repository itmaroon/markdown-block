{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"lib": [ "DOM", "DOM.Iterable", "ESNext" ],
		"jsx": "preserve",
		"moduleResolution": "bundler",
		"strict": true,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": [],
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"allowJs": false,
		"noEmit": true
	},
	"include": [ "src/**/*.ts", "src/**/*.tsx" ],
	"exclude": [ "node_modules", "build" ]
}
